# Campus Collective Environment Configuration

# Google Gemini API Key (Required for GEMINI ENHANCED mode)
# If left blank, the application operates seamlessly in OFFLINE ENGINE mode.
GEMINI_API_KEY=

# Configurable Gemini Model (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend API URL
VITE_API_URL=http://localhost:8000
